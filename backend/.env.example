# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins for CORS (the frontend URL)
CORS_ORIGIN=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. For Supabase use the pooled connection URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scopeguard?schema=public

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate strong secrets, e.g.  openssl rand -hex 32
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── Claude AI (Anthropic) ───────────────────────────────────────────────────
# The AI engine that powers scope analysis, contract generation & email drafting.
# Without a key the app runs in heuristic "demo" mode (no external calls).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ─── Payments (Stripe) ───────────────────────────────────────────────────────
# Optional. Without a key, invoices generate a mock payment link.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email (Resend) — optional, used by the reminder engine ──────────────────
RESEND_API_KEY=
EMAIL_FROM="ScopeGuard <invoices@scopeguard.io>"

# Public base URL used to build client-portal & payment links
APP_PUBLIC_URL=http://localhost:3000
